    {
      "parameters": {
        "jsCode": "function slugify(s) {\n  return s\n    .toString()\n    .toLowerCase()\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/(^-|-$)/g, '');\n}\n\nconst input = items[0].json;\nconst projectName = input['Nombre del proyecto'];\nconst idea = input['Idea / Descripción'];\nconst notes = input['Notas'] || '';\n\nconst slug = `${slugify(projectName)}-${Date.now().toString(36)}`;\nconst basePathHost = `/opt/aiq/product-factory/repo/projects/${slug}`;\nconst basePathContainer = `/aiq/product-factory/repo/projects/${slug}`;\n\nconst requirementsMd = `# ${projectName}\\n\\n## Idea / Descripción\\n\\n${idea}\\n\\n## Notas\\n\\n${notes}\\n`;\n\nreturn [{\n  json: {\n    projectName,\n    idea,\n    notes,\n    slug,\n    basePathHost,\n    basePathContainer,\n    requirementsMd\n  }\n}];"
      },
      "id": "code-slug-01",
      "name": "Generar Slug",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        304
      ]
    },
